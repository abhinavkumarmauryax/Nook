{
  "name": "nook",
  "version": "1.0.0",
  "description": "Self-hosted local-network Nook app: synchronized video playback and real-time chat. Free, no cloud, no accounts.",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "hls.js": "^1.7.4",
    "socket.io": "^4.7.5"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nook",
    "sync-video",
    "socket.io",
    "express",
    "local-network",
    "streaming"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "rcedit": "^3.1.0"
  }
}
